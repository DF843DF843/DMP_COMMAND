          "type": "Compose",
          "inputs": "@concat('{\"dummy\":\"\"', join(body('Select_ConfigEntries'), ''), '}')",
          "description": "Completes the configuration JSON text by wrapping all resolved property fragments in braces."
        },
        "CMP_ConfigObject": {
          "runAfter": {
