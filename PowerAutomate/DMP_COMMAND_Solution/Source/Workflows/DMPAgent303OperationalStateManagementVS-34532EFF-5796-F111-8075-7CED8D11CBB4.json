          },
          "type": "Select",
          "inputs": {
            "from": "@body('GET_DMP_Command_Configuration')?['value']",
            "select": "@concat(\n  ',',\n  '\"',\n  replace(coalesce(item()?['Title'], ''), '\"', concat(decodeUriComponent('%5C'), '\"')),\n  '\":\"',\n  replace(\n    replace(\n      replace(\n        replace(\n          coalesce(\n            if(\n              equals(variables('OperationMode'), 'PROD_NODMP'),\n              item()?['Value_PROD_NODMP'],\n              if(\n                equals(variables('OperationMode'), 'PROD_DMP'),\n                item()?['Value_x002d_PROD_x0028_DMP_x0029'],\n                if(\n                  equals(variables('OperationMode'), 'SIMU_NODMP'),\n                  coalesce(item()?['Value_x002d_SIMU_x0028_NODMP_x0029'], item()?['Value_x002d_SIMU_x0028_NODMP_x00']),\n                  item()?['Value_x002d_SIMU_x0028_DMP_x0029']\n                )\n              )\n            ),\n            ''\n          ),\n          decodeUriComponent('%5C'),\n          concat(decodeUriComponent('%5C'), decodeUriComponent('%5C'))\n        ),\n        '\"',\n        concat(decodeUriComponent('%5C'), '\"')\n      ),\n      decodeUriComponent('%0D'),\n      ''\n    ),\n    decodeUriComponent('%0A'),\n    concat(decodeUriComponent('%5C'), 'n')\n  ),\n  '\"'\n)"
          },
          "description": "Maps each configuration row to a mode-resolved JSON key-value fragment, replacing the slow per-row loop with a single non-looping data operation."
        },
        "CMP_ConfigJsonText": {
          "runAfter": {
            "Select_ConfigEntries": [
